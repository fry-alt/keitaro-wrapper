# Keitaro: адрес трекера (без /admin) и ключ Admin API
KEITARO_URL=https://tlgk.host
KEITARO_API_KEY=

# Все создаваемые кампании получают этот префикс
CAMPAIGN_PREFIX=test_ivanov_

# Домен, группа и источник новых кампаний (ищутся в Keitaro по названию)
DEFAULT_DOMAIN=kylovoa.com
DEFAULT_GROUP=FORTESTS
DEFAULT_TRAFFIC_SOURCE=FORTESTS
# Куда первый поток отправляет трафик из выбранных стран
REDIRECT_URL=https://google.com

# База: SQLite для локального запуска. В docker-compose подставляется PostgreSQL
DATABASE_URL=sqlite:///./data/app.db

# Пароль входа в приложение. Пустой — вход не нужен (только для локального запуска).
# На Vercel без пароля приложение не запустится
APP_PASSWORD=
# Ключ подписи cookie (длинная случайная строка). Пустой — выводится из пароля
SECRET_KEY=
# Править можно только кампании с CAMPAIGN_PREFIX. 1 — любые (осторожно: трекер общий)
# EDIT_ANY_CAMPAIGN=0

# Демо-режим без настоящего Keitaro (данные в памяти)
# KEITARO_FAKE=1
